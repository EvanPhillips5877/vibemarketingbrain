# Copy to .env for local development. Nothing here is a real secret.
NODE_ENV=development
PORT=5100
PUBLIC_BASE_URL=http://localhost:5100
DATABASE_URL=postgres://test:test@localhost:5432/marketingbrain

# Signs session and OAuth state cookies. Any long random string locally.
APP_SECRET=local-dev-secret-change-me-0123456789

# Who may sign in. Comma-separated, case-insensitive. Nobody else gets a session.
ALLOWED_EMAILS=evan@elitesultimate.com

# Google sign-in. Leave both unset locally and the app offers a dev sign-in
# form instead (refused when NODE_ENV=production).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Background jobs (pg-boss). Off by default so tests and ad-hoc scripts
# don't start schedulers.
JOBS_ENABLED=false

# TryoutBrain's funnel export (org-level rows, no personal data). Both unset
# = a mock funnel invented from the mock ad account. Staging first.
# TRYOUTBRAIN_EXPORT_URL=https://staging.tryoutbrain.com/api/internal/marketing/events
# TRYOUTBRAIN_EXPORT_TOKEN=

# Integrations. Unset = mock mode for that integration. Real values live in
# the secret store in production, never in this file.
# ANTHROPIC_API_KEY=
# META_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_REFRESH_TOKEN=
